ARG SUBDIR=server

FROM scratch AS ctx

ARG SUBDIR
COPY --chmod=0755 ./${SUBDIR}/build.sh /
COPY ./${SUBDIR}/packages /packages/specific
COPY ./common/packages /packages/common

#COPY --chmod=0755 ./server/build.sh /

FROM quay.io/fedora/fedora-bootc:latest

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

RUN bootc container lint
